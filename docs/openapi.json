  "components": {
    "schemas": {
      "AppointmentStatus": {
        "type": "integer"
      },
      "Category": {
        "type": "integer"
      },
      "ChangeAppointmentStatusRequest": {
        "required": [
          "id",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/AppointmentStatus"
          }
        }
      },
      "ChangeAppointmentTimeRequest": {
        "required": [
          "id",
          "date",
          "time"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          }
        }
      },
      "ChangeScheduleRequest": {
        "required": [
          "id",
          "isWorking",
          "workInterval",
          "breakInterval"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isWorking": {
            "type": "boolean"
          },
          "workInterval": {
            "$ref": "#/components/schemas/TimeInterval"
          },
          "breakInterval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TimeInterval"
              }
            ]
          }
        }
      },
      "ChangeSettingsRequest": {
        "required": [
          "address",
          "phone",
          "workInterval",
          "breakInterval",
          "generationEnabled",
          "horizonDays",
          "weekendDays"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "workInterval": {
            "$ref": "#/components/schemas/TimeInterval"
          },
          "breakInterval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TimeInterval"
              }
            ]
          },
          "generationEnabled": {
            "type": "boolean"
          },
          "horizonDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "weekendDays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOfWeek"
            }
          }
        }
      },
      "CreateAppointmentForUserRequest": {
        "required": [
          "phone",
          "date",
          "time",
          "offeringIds",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "offeringIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateAppointmentRequest": {
        "required": [
          "date",
          "time",
          "offeringIds"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "offeringIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreateOfferingRequest": {
        "required": [
          "price",
          "title",
          "description",
          "duration",
          "category"
        ],
        "type": "object",
        "properties": {
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "duration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        }
      },
      "CreateScheduleRequest": {
        "required": [
          "date",
          "workInterval",
          "breakInterval"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "workInterval": {
            "$ref": "#/components/schemas/TimeInterval"
          },
          "breakInterval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TimeInterval"
              }
            ]
          }
        }
      },
      "DayOfWeek": {
        "type": "integer"
      },
      "GetAvailableDatesRequest": {
        "required": [
          "offeringIds"
        ],
        "type": "object",
        "properties": {
          "offeringIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "code",
          "phone"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "Money": {
        "required": [
          "value",
