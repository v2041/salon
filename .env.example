# Публичный адрес сайта. Для VPS с доменом: https://salon.example.com
# Для проверки по IP без TLS: http://1.2.3.4
PUBLIC_URL=http://localhost

# Адрес сайта для Caddy.
# Для VPS с доменом: salon.example.com (нужны DNS A/AAAA и порты 80/443)
# Для локальной проверки без TLS: :80
DOMAIN=:80

POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me

JWT_ISSUER=salon
JWT_AUDIENCE=salon-client
# Случайная строка не короче 32 символов: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars

TZ=Europe/Moscow
